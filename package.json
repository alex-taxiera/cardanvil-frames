{
  "name": "my-card-frames",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Custom frames for Card Anvil.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "new-frame": "node scripts/new-frame.js",
    "studio": "frame-kit studio",
    "validate": "frame-kit validate",
    "build": "frame-kit build --out dist",
    "watch": "frame-kit build --out dist --watch",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@cardanvil/frame-kit": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@cardanvil/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "volta": {
    "node": "24.16.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
